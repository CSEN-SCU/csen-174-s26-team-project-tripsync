# TripSync — Groq (Orpheus TTS + LLM chat)
#
# The Flutter app reads these at compile time via Dart defines (not from a bundled .env).
#
# Option A — define file (recommended for local dev):
#   From the `app/` directory:
#     flutter run --dart-define-from-file=.env
#   Put lines in your local `.env` (gitignored; same pattern as **/.env), for example:
#     GROQ_API_KEY=gsk_your_key_here
#     GROQ_LLM_MODEL=llama-3.3-70b-versatile
#   Use the raw token only: no surrounding quotes (they would be sent as part of the key and
#   Groq will reject the request), and no spaces around `=`.
#
# Optional LLM overrides (defaults work for Groq OpenAI-compatible chat):
#   GROQ_LLM_MODEL — defaults to llama-3.3-70b-versatile
#   GROQ_LLM_BASE_URL — defaults to https://api.groq.com/openai/v1
#
# Option B — inline:
#     flutter run --dart-define=GROQ_API_KEY=gsk_your_key_here
#
# Xcode: add the same flags under Run → Arguments → "Arguments Passed On Launch", or use a
# custom scheme that invokes Flutter with `--dart-define-from-file`.
#
# Security: keys baked into debug/profile builds are extractable. For production, proxy TTS
# and LLM through your backend instead of shipping a Groq key in the client.

GROQ_API_KEY=gsk_your_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1

# Firebase client (same names as GitHub repository secrets; CI injects these automatically)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=your-android-app-id
FIREBASE_ANDROID_OAUTH_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_IOS_APP_ID=your-ios-app-id
FIREBASE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
FIREBASE_IOS_BUNDLE_ID=edu.scu.orbit
