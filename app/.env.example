# Orbit — OpenRouter TTS + Groq LLM/POI narration
#
# GROQ_API_KEY powers:
#   - POI narration + follow-up answers: groq/compound-mini (built-in web search)
#   - LLM chat tab: llama-3.3-70b-versatile (or GROQ_LLM_MODEL override)
#
# OPENROUTER_API_KEY powers:
#   - Speech: mistralai/voxtral-mini-tts-2603
#   - Backup speech: x-ai/grok-voice-tts-1.0
#
# Copy to `.env` in this directory (gitignored). The app loads it at startup when you
# run from Xcode or `flutter run` without extra flags:
#
#   cp .env.example .env
#   # edit GROQ_API_KEY=gsk_your_key_here
#   # edit OPENROUTER_API_KEY=sk-or-v1_your_key_here
#
# Optional — compile-time define (CI / release builds):
#   flutter run --dart-define-from-file=.env
#
# Use the raw token only: no surrounding quotes (they would be sent as part of the key
# and providers will reject the request), and no spaces around `=`.
#
# Security: keys baked into debug/profile builds are extractable. For production, proxy
# TTS and LLM through your backend instead of shipping API keys in the client.

GROQ_API_KEY=gsk_your_key_here
OPENROUTER_API_KEY=sk-or-v1_your_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1

# Firebase client (same names as GitHub repository secrets; CI injects these automatically)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_ANDROID_APP_ID=your-android-app-id
FIREBASE_ANDROID_OAUTH_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_IOS_APP_ID=your-ios-app-id
FIREBASE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
FIREBASE_IOS_BUNDLE_ID=edu.scu.orbit
