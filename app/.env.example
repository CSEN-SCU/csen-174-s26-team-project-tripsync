# TripSync — Groq (Orpheus TTS + LLM chat + POI narration)
#
# GROQ_API_KEY powers:
#   - POI narration + follow-up answers: groq/compound-mini (built-in web search)
#   - Speech: canopylabs/orpheus-v1-english (max 200 chars per spoken line)
#   - LLM chat tab: llama-3.3-70b-versatile (or GROQ_LLM_MODEL override)
#
# Copy to `.env` in this directory (gitignored). The app loads it at startup when you
# run from Xcode or `flutter run` without extra flags:
#
#   cp .env.example .env
#   # edit GROQ_API_KEY=gsk_your_key_here
#
# Optional — compile-time define (CI / release builds):
#   flutter run --dart-define-from-file=.env
#
# Use the raw token only: no surrounding quotes (they would be sent as part of the key
# and Groq will reject the request), and no spaces around `=`.
#
# Security: keys baked into debug/profile builds are extractable. For production, proxy
# TTS and LLM through your backend instead of shipping a Groq key in the client.

GROQ_API_KEY=gsk_your_key_here
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_BASE_URL=https://api.groq.com/openai/v1
