rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile doc.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // POI catalog is public read (seeded reference data). Writes stay admin-only.
    match /pois/{poiId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
